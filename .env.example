# Copy to .env and fill in real values. Never commit .env.
#
# See docs/specs/backend.md Section 15 for full descriptions.

### Server (rc-mcp-server) ###

# Bearer token for MCP client authentication. Required -- the server
# refuses to start if unset. Use a long, high-entropy value (recommended:
# 64 bytes hex-encoded), e.g. `openssl rand -hex 64`.
AUTH_TOKEN=

# Address for MCP + agent WS endpoints.
MCP_BIND_ADDR=0.0.0.0:8080

# Address for the admin API (pairing approval, device revocation).
# Loopback only -- never expose this through nginx or a public interface.
ADMIN_BIND_ADDR=127.0.0.1:9090

# Comma-separated allowlist of Origin headers accepted for MCP clients.
MCP_ALLOWED_ORIGINS=

# Session store backend: memory or redis.
MCP_SESSION_STORE=memory

# Duration after which idle MCP sessions are expired.
MCP_SESSION_IDLE_TIMEOUT=30m

# Number of SSE events retained per session for replay.
SSE_REPLAY_BUFFER_SIZE=500

# How long a pairing code remains valid.
PAIRING_CODE_TTL=5m

# Path to the persistent device registry file.
DEVICE_REGISTRY_PATH=/var/lib/rc-mcp/devices.json

# How long the server keeps an agent's in-flight state alive after
# disconnect.
AGENT_RECONNECT_GRACE_PERIOD=60s

# Max wall-clock duration for a long-running job (e.g. screenshot_watch).
JOB_TIMEOUT=300s

# Minimum ms between progress notifications bridged to the MCP client.
JOB_PROGRESS_MIN_INTERVAL_MS=500

# Skip elicitation confirmation for shell tools.
RC_SHELL_SKIP_CONFIRM=false

# Require confirmation on every shell_session_write.
RC_SHELL_CONFIRM_EVERY_WRITE=false

# Skip elicitation confirmation for filesystem writes.
RC_FS_SKIP_CONFIRM=false

# Skip elicitation confirmation for process signals.
RC_PROCESS_SKIP_CONFIRM=false

# Path to the server-side audit log.
RC_AUDIT_LOG_PATH=/var/log/rc-mcp/audit.log

# Max requests per MCP session per minute.
RC_RATE_LIMIT_SESSION=120

# Max tool calls per MCP session per minute.
RC_RATE_LIMIT_TOOLS=60

# Max dispatches per agent per minute.
RC_RATE_LIMIT_AGENT=120

# Max concurrent in-flight dispatches per MCP session.
RC_MAX_CONCURRENT_DISPATCHES=10

# Max concurrent shell sessions per MCP session.
RC_MAX_SHELL_SESSIONS=5

# Timeout for elicitation responses from MCP clients.
RC_ELICITATION_TIMEOUT=120s

### Agent (rc-mcp-agent) ###

# WebSocket URL of the server. Required.
AGENT_SERVER_URL=wss://server-host/agent/ws

# Path to the persistent device token file.
AGENT_TOKEN_PATH=~/.rc-mcp/agent-token

# Comma-separated list of enabled capability areas.
AGENT_CAPABILITIES=shell,screenshot,filesystem,process,sysinfo

# Comma-separated absolute paths for filesystem tool restrictions.
# Empty = unrestricted.
AGENT_FS_ALLOWED_ROOTS=

# Optional agent-side audit log path. Empty = disabled.
AGENT_AUDIT_LOG_PATH=

# How long the agent keeps local job state alive during a disconnect.
AGENT_RECONNECT_GRACE_PERIOD=60s

# X11 display for screenshot tools.
DISPLAY=:0
