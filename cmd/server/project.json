{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "cmd/server",
  "implicitDependencies": ["protocol", "session", "transport", "audit", "mcp"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o bin/rc-mcp-server ./cmd/server",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./cmd/server/... ./internal/agent/... ./internal/admin/... ./internal/auth/... ./internal/devices/...",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run --allow-parallel-runners ./cmd/server/...",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
